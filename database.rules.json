{
  "rules": {
    "sectors": {
      "$sector": {
        ".read": true,
        ".write": "auth != null",

        "wiki": {
          "$id": {
            "image": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1400000)"
            }
          }
        }
      }
    },

    "sectorNotes": {
      "$sector": {
        ".read": true,
        ".write": "auth != null"
      }
    }
  }
}
