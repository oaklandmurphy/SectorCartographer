rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Wiki-entry images: processImage() (see src/lib/codexImage.js) already
    // downscales/re-encodes client-side, so this is a backstop, not the only
    // check. Same read/write posture as database.rules.json: world-readable,
    // auth required to write (every visitor gets a silent anonymous token).
    match /wikiImages/{sector}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 1200 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Ship-art SVGs (see src/lib/shipArt.js) — same MAX_ART_BYTES cap enforced
    // client-side, backstopped here.
    match /art/{sector}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 128 * 1024;
    }
  }
}
